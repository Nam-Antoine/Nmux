{
  "name": "nmux",
  "version": "0.1.0",
  "description": "Nmux - a persistent desktop home for Claude Code sessions. Sessions keep running when the window is closed.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Nathan Collins",
  "license": "MIT",
  "homepage": "https://github.com/Nam-Antoine/Nmux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nam-Antoine/Nmux.git"
  },
  "bugs": {
    "url": "https://github.com/Nam-Antoine/Nmux/issues"
  },
  "keywords": [
    "claude-code",
    "electron",
    "terminal",
    "xterm",
    "node-pty",
    "tmux",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "pnpm build && electron-builder --win",
    "dist:dir": "pnpm build && electron-builder --win --dir",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
