{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nmux",
  "identifier": "dev.nmux.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Nmux", "width": 1280, "height": 800, "minWidth": 720, "minHeight": 420, "decorations": false, "shadow": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
